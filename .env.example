DATABASE_URL=postgresql://aurex:aurex@localhost:5435/aurex?schema=public
REDIS_URL=redis://localhost:6379
API_PORT=4010
WORKSPACE_IMAGE=aurex-workspace:latest
DEFAULT_MODEL=opencode/big-pickle
RUN_TIMEOUT_MS=600000
# BYOK provider keys are picked up here and injected into workspaces when used
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Google OAuth (leave unset to run in open/no-auth mode)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# SESSION_SECRET=
# AUREX_PUBLIC_BASE_URL=
# AUREX_INTERNAL_KEY= # required for worker auto-publish (fail-closed if empty)
# AUREX_TUNNEL_CONFIG=$HOME/.cloudflared/config.yml
# AUREX_TUNNEL_NAME=auracle-tunnel
# AUREX_NPROXY_HELPER=/usr/local/sbin/aurex-publish
# AUREX_WEBROOT=/var/www/html
# AUREX_HOST_MODE=false  # true = run agent directly on host (full filesystem)
# AUREX_HOST_ROOT=/      # host root when HOST_MODE=true (defaults to $HOME/workspace)
# AUREX_BACKEND_PORT=4000
# AUREX_PUBLISH_DOMAIN=example.com  # base domain for published apps: <slug>.AUREX_PUBLISH_DOMAIN
# AUREX_ALLOWED_ORIGINS=https://aurex.example.com,http://localhost:5173
# API_RATE_LIMIT=120
