{
  "name": "@aurex/browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin/browser-plugin.d.ts",
      "import": "./dist/plugin/browser-plugin.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --import tsx --test test/*.test.ts",
    "install:chromium": "playwright install chromium"
  },
  "dependencies": {
    "@aurex/shared": "*",
    "playwright-core": "^1.48.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "playwright": "^1.48.2",
    "tsx": "^4.19.2"
  }
}
